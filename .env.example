# Copy this file to .env and fill in your real values.
# .env is gitignored and never committed — keep credentials out of version control.

# Snowflake — find account identifier at: bottom-left avatar > Account > Locator
# Format is typically: orgname-accountname (e.g. myorg-abc12345)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
